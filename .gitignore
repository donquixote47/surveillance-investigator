# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node (AgentCore CLI's CDK app)
node_modules/

# CDK / build outputs (regenerate: `cdk synth` in infra/, `infra/build_layer.sh`, `agentcore deploy`)
cdk.out/
cdk.context.json
infra/build/
!infra/build/outputs.json
agentcore/.cache/
*.zip

# AgentCore CLI local state: keep the deployed-state binding, drop scratch
agentcore/.cli/*
!agentcore/.cli/deployed-state.json
.bedrock_agentcore/

# Evaluation run outputs (large, regenerable)
evals/runs/

# Secrets and local env. Analyst passwords live in ~/.config/surv-investigator/ (outside the repo).
.env
.env.*
*.pem
*.key

# Kiro hook state markers
.kiro/.docs-sync-*
.kiro/.session-*

# macOS
.DS_Store

# Synthetic dataset IS committed (data/synthetic/seed7, ~23 MB, deterministic from build_dataset.py --seed 7).
# Exclude only ad-hoc builds under other names.
data/synthetic/tmp*/
data/synthetic/scratch*/
