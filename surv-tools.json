[
  {
    "name": "get_alert",
    "description": "Start of every investigation. Returns the alert raised by the surveillance detector: trader, instrument, the detector's scenario (SPOOFING or LAYERING), trigger, time window and the detector's own one-line summary with its parameters.",
    "inputSchema": {
      "type": "object",
      "description": "",
      "properties": {
        "alert_id": {
          "type": "string",
          "description": "alert identifier, e.g. A-261005-0002"
        }
      },
      "required": [
        "alert_id"
      ]
    },
    "outputSchema": {
      "type": "object",
      "description": "",
      "properties": {
        "alert_id": {
          "type": "string",
          "description": ""
        },
        "date": {
          "type": "string",
          "description": "YYYY-MM-DD"
        },
        "scenario": {
          "type": "string",
          "description": "SPOOFING or LAYERING"
        },
        "instrument": {
          "type": "string",
          "description": ""
        },
        "trader_id": {
          "type": "string",
          "description": ""
        },
        "trigger": {
          "type": "string",
          "description": "OPPOSITE_FILL_CANCEL or LARGE_QUICK_CANCEL"
        },
        "trigger_ts": {
          "type": "integer",
          "description": "nanoseconds since epoch"
        },
        "window_start": {
          "type": "integer",
          "description": "nanoseconds since epoch"
        },
        "window_end": {
          "type": "integer",
          "description": "nanoseconds since epoch"
        },
        "window_start_time": {
          "type": "string",
          "description": "HH:MM:SS.mmm"
        },
        "window_end_time": {
          "type": "string",
          "description": "HH:MM:SS.mmm"
        },
        "window_seconds": {
          "type": "number",
          "description": "length of the detector window; the detector uses a fixed 60 s look-back"
        },
        "trigger_summary": {
          "type": "string",
          "description": "the detector's explanation of why it fired"
        },
        "detector_version": {
          "type": "string",
          "description": ""
        },
        "detector_params": {
          "type": "string",
          "description": "JSON of the detector parameters in force"
        },
        "status": {
          "type": "string",
          "description": "OPEN, IN_REVIEW, CLOSED or ESCALATED"
        }
      },
      "required": [
        "alert_id",
        "trader_id",
        "instrument",
        "window_start",
        "window_end"
      ]
    }
  },
  {
    "name": "get_order_events",
    "description": "The trader's raw order lifecycle events (NEW, MODIFY, CANCEL, FILL, PARTIAL_FILL) inside the alert window, optionally padded, with the best bid and ask before each event. Paginated; follow next_token.",
    "inputSchema": {
      "type": "object",
      "description": "",
      "properties": {
        "alert_id": {
          "type": "string",
          "description": ""
        },
        "pad_seconds": {
          "type": "number",
          "description": "seconds of context before and after the window (default 0, max 600)"
        },
        "next_token": {
          "type": "string",
          "description": "pagination token from a previous call"
        }
      },
      "required": [
        "alert_id"
      ]
    },
    "outputSchema": {
      "type": "object",
      "description": "",
      "properties": {
        "alert_id": {
          "type": "string",
          "description": ""
        },
        "trader_id": {
          "type": "string",
          "description": ""
        },
        "events": {
          "type": "array",
          "description": "events in time order",
          "items": {
            "type": "object",
            "description": "one order lifecycle event",
            "properties": {
              "ts": {
                "type": "integer",
                "description": "nanoseconds since epoch"
              },
              "time": {
                "type": "string",
                "description": "HH:MM:SS.mmm, venue local time"
              },
              "order_id": {
                "type": "string",
                "description": ""
              },
              "event": {
                "type": "string",
                "description": "NEW, MODIFY, CANCEL, FILL or PARTIAL_FILL"
              },
              "side": {
                "type": "string",
                "description": "BUY or SELL"
              },
              "price_ticks": {
                "type": "number",
                "description": "limit price in ticks; absent for market orders"
              },
              "qty": {
                "type": "integer",
                "description": "NEW = size, FILL/PARTIAL_FILL = executed, CANCEL = removed, MODIFY = signed delta"
              },
              "remaining_qty": {
                "type": "integer",
                "description": "open quantity after the event"
              },
              "order_type": {
                "type": "string",
                "description": "LIMIT, MARKET, PEGGED or ICEBERG"
              },
              "parent_order_id": {
                "type": "string",
                "description": "client or algo parent order, if any"
              },
              "best_bid": {
                "type": "number",
                "description": "best bid immediately before the event, ticks"
              },
              "best_ask": {
                "type": "number",
                "description": "best ask immediately before the event, ticks"
              }
            }
          }
        },
        "event_count": {
          "type": "integer",
          "description": "events returned in this page"
        },
        "total_in_range": {
          "type": "integer",
          "description": "events in the requested range"
        },
        "next_token": {
          "type": "string",
          "description": "present when more pages follow"
        }
      },
      "required": [
        "alert_id",
        "events"
      ]
    }
  },
  {
    "name": "reconstruct_book",
    "description": "What the market looked like: the best bid/ask path through the window and resting depth by price level at a given instant, separating the trader's own orders from everyone else's. Depth is tabulated from the whole day's tape up to the instant (no re-matching).",
    "inputSchema": {
      "type": "object",
      "description": "",
      "properties": {
        "alert_id": {
          "type": "string",
          "description": ""
        },
        "at_ts": {
          "type": "integer",
          "description": "instant for the depth snapshot, ns since epoch (default: the alert's trigger_ts)"
        },
        "levels": {
          "type": "integer",
          "description": "price levels per side in the snapshot (default 5, max 20)"
        },
        "sample_every_ms": {
          "type": "integer",
          "description": "BBO path sampling interval (default 1000)"
        }
      },
      "required": [
        "alert_id"
      ]
    },
    "outputSchema": {
      "type": "object",
      "description": "",
      "properties": {
        "alert_id": {
          "type": "string",
          "description": ""
        },
        "at_ts": {
          "type": "integer",
          "description": ""
        },
        "at_time": {
          "type": "string",
          "description": ""
        },
        "bids": {
          "type": "array",
          "description": "best first",
          "items": {
            "type": "object",
            "description": "",
            "properties": {
              "price_ticks": {
                "type": "number",
                "description": ""
              },
              "total_qty": {
                "type": "integer",
                "description": ""
              },
              "trader_qty": {
                "type": "integer",
                "description": "the alert's trader's share"
              }
            }
          }
        },
        "asks": {
          "type": "array",
          "description": "best first",
          "items": {
            "type": "object",
            "description": "",
            "properties": {
              "price_ticks": {
                "type": "number",
                "description": ""
              },
              "total_qty": {
                "type": "integer",
                "description": ""
              },
              "trader_qty": {
                "type": "integer",
                "description": ""
              }
            }
          }
        },
        "mid_ticks": {
          "type": "number",
          "description": ""
        },
        "spread_ticks": {
          "type": "number",
          "description": ""
        },
        "bbo_path": {
          "type": "array",
          "description": "sampled through the window",
          "items": {
            "type": "object",
            "description": "",
            "properties": {
              "time": {
                "type": "string",
                "description": ""
              },
              "best_bid": {
                "type": "number",
                "description": ""
              },
              "best_ask": {
                "type": "number",
                "description": ""
              },
              "mid": {
                "type": "number",
                "description": ""
              }
            }
          }
        }
      },
      "required": [
        "alert_id"
      ]
    }
  },
  {
    "name": "compute_discriminators",
    "description": "The deterministic numbers an analyst computes for a spoofing alert, from the tape and the instrument's average depth: order-to-trade ratio, cancel ratio and latency, peak resting size vs depth, distance from the touch at placement, same-side vs opposite-side executions, MODIFY reductions, cancel symmetry across sides, price move before the trader's opposite-side execution, post-cancel move and reversion, round-trip P&L in ticks, repetitions over the session, and how many other traders cancelled in the second before this trader's first cancel. Vocabulary follows Delegated Regulation (EU) 2016/522 Annex II. Every value is reproducible from get_order_events.",
    "inputSchema": {
      "type": "object",
      "description": "",
      "properties": {
        "alert_id": {
          "type": "string",
          "description": ""
        }
      },
      "required": [
        "alert_id"
      ]
    },
    "outputSchema": {
      "type": "object",
      "description": "",
      "properties": {
        "alert_id": {
          "type": "string",
          "description": ""
        },
        "evidence_id": {
          "type": "string",
          "description": "stable id for citing this computation in the report"
        },
        "trader_id": {
          "type": "string",
          "description": ""
        },
        "window_seconds": {
          "type": "number",
          "description": ""
        },
        "avg_depth_top5": {
          "type": "number",
          "description": "instrument's average one-side top-5 depth for the day"
        },
        "dominant_side": {
          "type": "string",
          "description": "side with the larger gross submitted size in the window"
        },
        "gross_submitted_dominant": {
          "type": "integer",
          "description": ""
        },
        "gross_submitted_other": {
          "type": "integer",
          "description": ""
        },
        "otr": {
          "type": "number",
          "description": "(NEW+MODIFY+CANCEL)/executions; null when no executions"
        },
        "cancel_ratio": {
          "type": "number",
          "description": "cancelled or reduced qty / submitted qty"
        },
        "median_cancel_latency_ms": {
          "type": "number",
          "description": "placement to cancel, dominant side"
        },
        "max_resting_size_vs_depth": {
          "type": "number",
          "description": ""
        },
        "distance_from_touch_ticks": {
          "type": "number",
          "description": "size-weighted at placement; negative = improving the touch"
        },
        "distinct_price_levels": {
          "type": "integer",
          "description": ""
        },
        "large_order_ids": {
          "type": "array",
          "description": "dominant-side orders >= 3 x depth",
          "items": {
            "type": "string",
            "description": ""
          }
        },
        "same_side_fill_qty": {
          "type": "integer",
          "description": "executed on the trader's own dominant-side orders"
        },
        "opposite_side_fill_qty": {
          "type": "integer",
          "description": ""
        },
        "opposite_side_fills": {
          "type": "array",
          "description": "",
          "items": {
            "type": "object",
            "description": "",
            "properties": {
              "ts": {
                "type": "integer",
                "description": ""
              },
              "time": {
                "type": "string",
                "description": ""
              },
              "price_ticks": {
                "type": "number",
                "description": ""
              },
              "qty": {
                "type": "integer",
                "description": ""
              },
              "ms_before_first_cancel": {
                "type": "number",
                "description": ""
              }
            }
          }
        },
        "modify_reduction_qty": {
          "type": "integer",
          "description": ""
        },
        "cancel_symmetry": {
          "type": "number",
          "description": "1 = equal cancels on both sides, 0 = one-sided"
        },
        "price_move_ticks": {
          "type": "number",
          "description": "+ = moved the way a spoofer on the dominant side would want, before he traded"
        },
        "post_cancel_move_ticks": {
          "type": "number",
          "description": "same orientation, 10 s after the last cancel"
        },
        "reversion_ticks": {
          "type": "number",
          "description": "favourable pre-trade move undone after the cancel; 0 when there was none"
        },
        "round_trip_ticks": {
          "type": "number",
          "description": "SELL VWAP minus BUY VWAP in the window; negative = a loss"
        },
        "repetitions_in_session": {
          "type": "integer",
          "description": ""
        },
        "market_wide_cancels_1s_before_first_cancel": {
          "type": "integer",
          "description": "distinct other traders"
        },
        "order_types": {
          "type": "object",
          "description": "counts by order type",
          "properties": {}
        },
        "parent_order_ids": {
          "type": "array",
          "description": "",
          "items": {
            "type": "string",
            "description": ""
          }
        },
        "notes": {
          "type": "array",
          "description": "deterministic remarks, e.g. executions on the dominant side",
          "items": {
            "type": "string",
            "description": ""
          }
        }
      },
      "required": [
        "alert_id",
        "evidence_id",
        "dominant_side"
      ]
    }
  },
  {
