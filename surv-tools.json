  {
    "name": "recall_memory",
    "description": "What analysts have recorded before about this trader, the trader's desk and this instrument, and the firm's procedures, retrieved from AgentCore Memory by meaning. Returns prior dispositions (with override flags and the analyst's note), analyst feedback, instrument notes. Context for the investigation, never a reason on its own to close an alert. Call it right after get_alert, before the evidence tools.",
    "inputSchema": {
      "type": "object",
      "description": "",
      "properties": {
        "alert_id": {
          "type": "string",
          "description": "the alert under investigation"
        },
        "trader_id": {
          "type": "string",
          "description": "the alerted trader"
        },
        "instrument": {
          "type": "string",
          "description": "the alert's instrument"
        },
        "query": {
          "type": "string",
          "description": "what you want to know, e.g. 'prior dispositions and analyst notes on this trader'"
        },
        "top_k": {
          "type": "integer",
          "description": "records per namespace, default 5"
        }
      },
      "required": [
        "alert_id",
        "trader_id",
        "instrument"
      ]
    },
    "outputSchema": {
      "type": "object",
      "description": "",
      "properties": {
        "alert_id": {
          "type": "string",
          "description": ""
        },
        "trader_id": {
          "type": "string",
          "description": ""
        },
        "desk": {
          "type": "string",
          "description": "the trader's desk, from the profile"
        },
        "trader_notes": {
          "type": "array",
          "description": "prior dispositions, overrides and feedback on this trader",
          "items": {
            "type": "object",
            "description": "",
            "properties": {
              "text": {
                "type": "string",
                "description": ""
              },
              "score": {
                "type": "number",
                "description": ""
              },
              "source": {
                "type": "string",
                "description": ""
              },
              "metadata": {
                "type": "object",
                "description": "",
                "properties": {}
              },
              "record_id": {
                "type": "string",
                "description": ""
              }
            }
          }
        },
        "desk_notes": {
          "type": "array",
