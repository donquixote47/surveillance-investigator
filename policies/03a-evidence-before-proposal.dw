// 03a Evidence before proposal (1 of 2): a proposal is permitted only after the alert was read, its order
// events pulled and its discriminators computed in this session, and each of those calls RETURNED this
// alert's id. The match is on the answer (output.alert_id), not on the request: a tool that answers with an
// error returns no alert id, so a failed lookup does not count. Three temporal operators is the per-policy
// maximum, hence the split with 03b.
permit (
  principal is AgentCore::OAuthUser,
  action == AgentCore::Action::"surv___propose_disposition",
  resource == AgentCore::Gateway::"arn:aws:bedrock-agentcore:eu-west-2:384308066035:gateway/surv-default-surv-investigator-gsq1ismkrw"
)
when temporal {
  formerly within 2h AgentCore::Action::"surv___get_alert"::response{
    eventResource: resource,
    output.alert_id: context.input.alert_id
  }
  && formerly within 2h AgentCore::Action::"surv___get_order_events"::response{
    eventResource: resource,
    output.alert_id: context.input.alert_id
  }
  && formerly within 2h AgentCore::Action::"surv___compute_discriminators"::response{
    eventResource: resource,
    output.alert_id: context.input.alert_id
  }
};
