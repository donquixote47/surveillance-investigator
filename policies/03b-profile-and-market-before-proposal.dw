// 03b Evidence before proposal (2 of 2): the trader's profile and the market events must have been RETURNED
// for this alert in the session (output.alert_id). The profile tool answers with the alert's id only for the
// alert's own trader, the market tool only for the alert's own instrument and window; an answer that is an
// error carries none. A forbid-unless cannot be overridden by any permit.
forbid (
  principal,
  action == AgentCore::Action::"surv___propose_disposition",
  resource == AgentCore::Gateway::"arn:aws:bedrock-agentcore:eu-west-2:384308066035:gateway/surv-default-surv-investigator-gsq1ismkrw"
)
unless temporal {
  formerly within 2h AgentCore::Action::"surv___get_trader_profile"::response{
    eventResource: resource,
    output.alert_id: context.input.alert_id
  }
  && formerly within 2h AgentCore::Action::"surv___get_market_events"::response{
    eventResource: resource,
    output.alert_id: context.input.alert_id
  }
};
