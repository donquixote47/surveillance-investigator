// 03b Evidence before proposal (2 of 2): the trader's profile for this alert and a market-events lookup
// must have completed in the session. A forbid-unless cannot be overridden by any permit.
forbid (
  principal,
  action == AgentCore::Action::"surv___propose_disposition",
  resource == AgentCore::Gateway::"arn:aws:bedrock-agentcore:eu-west-2:384308066035:gateway/surv-default-surv-investigator-gsq1ismkrw"
)
unless temporal {
  formerly within 2h AgentCore::Action::"surv___get_trader_profile"::response{
    eventResource: resource,
    input.alert_id: context.input.alert_id
  }
  && formerly within 2h AgentCore::Action::"surv___get_market_events"::response{
    eventResource: resource
  }
};
