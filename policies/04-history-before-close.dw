// 04 A false-positive closure additionally needs the trader's alert history RETURNED for this alert in the
// session (output.alert_id; prior dispositions are context the closure standard requires the analyst to have
// seen). A history call that failed, or one for another alert or another trader, does not count.
forbid (
  principal,
  action == AgentCore::Action::"surv___propose_disposition",
  resource == AgentCore::Gateway::"arn:aws:bedrock-agentcore:eu-west-2:384308066035:gateway/surv-default-surv-investigator-gsq1ismkrw"
)
when { context.input.disposition == "CLOSE_FP" }
unless temporal {
  formerly within 2h AgentCore::Action::"surv___get_trader_alert_history"::response{
    eventResource: resource,
    output.alert_id: context.input.alert_id
  }
};
