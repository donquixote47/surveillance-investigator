// 06 One proposal per alert per session. Matching ::response is what makes the self-reference safe: the
// request being authorised has no response yet, so the first proposal does not forbid itself.
forbid (
  principal,
  action == AgentCore::Action::"surv___propose_disposition",
  resource == AgentCore::Gateway::"arn:aws:bedrock-agentcore:eu-west-2:384308066035:gateway/surv-default-surv-investigator-gsq1ismkrw"
)
when temporal {
  formerly within 24h AgentCore::Action::"surv___propose_disposition"::response{
    eventResource: resource,
    input.alert_id: context.input.alert_id
  }
};
