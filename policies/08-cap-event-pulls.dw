// 08 Bound cost and loops: at most 6 order-event pulls per session. `count` includes the current request,
// so the seventh call in the window is the first one denied. Behaviour shaping, not a security boundary:
// the caller names the session.
forbid (
  principal,
  action == AgentCore::Action::"surv___get_order_events",
  resource == AgentCore::Gateway::"arn:aws:bedrock-agentcore:eu-west-2:384308066035:gateway/surv-default-surv-investigator-gsq1ismkrw"
)
when temporal {
  exists (n: Long).
    (count for (t: Timepoint).
      where (formerly within 2h (AgentCore::Action::"surv___get_order_events"::request{ eventResource: resource } && tp(t)))) == n
    && n > 6
};
