// 05 A STOR narrative may be drafted only after a DRAFT_STOR proposal for the same alert completed.
// Correlates on the proposal's INPUT (what was proposed), which exists whether or not outputs are declared.
permit (
  principal is AgentCore::OAuthUser,
  action == AgentCore::Action::"surv___draft_stor_narrative",
  resource == AgentCore::Gateway::"arn:aws:bedrock-agentcore:eu-west-2:384308066035:gateway/surv-default-surv-investigator-gsq1ismkrw"
)
when temporal {
  formerly within 2h AgentCore::Action::"surv___propose_disposition"::response{
    eventResource: resource,
    input.alert_id: context.input.alert_id,
    input.disposition: "DRAFT_STOR"
  }
};
